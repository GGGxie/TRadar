# Core local service. TRadar does not load this file automatically; export it
# in your process manager or shell before starting the binary.
TRADAR_ADDR=127.0.0.1:8080
TRADAR_DB_PATH=data/radar.db
TRADAR_WEB_DIR=web/dist

# Required only when TRADAR_ADDR is not loopback. Use at least 32 random
# characters and prefer an SSH tunnel over direct exposure.
TRADAR_ACCESS_TOKEN=
TRADAR_ALLOWED_HOST=

# Development-only browser origin, for example http://127.0.0.1:5173.
TRADAR_DEV_ORIGIN=

# Optional source credentials. GitHub and Hacker News work without these;
# Product Hunt remains unavailable until its token is configured.
TRADAR_GITHUB_TOKEN=
TRADAR_PRODUCT_HUNT_TOKEN=

# Optional model analysis. Leave provider empty to keep all model calls off.
# When enabled, every value below is required except timeout, which defaults
# to 45s. Choose explicit output and UTC daily token limits.
TRADAR_MODEL_PROVIDER=
TRADAR_MODEL_NAME=
TRADAR_OPENAI_API_KEY=
TRADAR_MODEL_MAX_OUTPUT_TOKENS=
TRADAR_MODEL_DAILY_TOKEN_BUDGET=
TRADAR_MODEL_TIMEOUT=45s
